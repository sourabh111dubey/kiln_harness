{
  "name": "@kiln/cli",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "bin": {
    "kiln": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@kiln/core": "workspace:*",
    "@kiln/mcp": "workspace:*",
    "@kiln/shared": "workspace:*",
    "@kiln/server": "workspace:*",
    "@kiln/tui": "workspace:*",
    "commander": "15.1.0",
    "@kiln/sandbox": "workspace:*",
    "@kiln/lsp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
