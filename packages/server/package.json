{
  "name": "@kiln/server",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@kiln/core": "workspace:*",
    "@kiln/shared": "workspace:*",
    "@hono/node-server": "2.1.8",
    "@kiln/mcp": "workspace:*",
    "hono": "4.13.18",
    "zod": "4.6.7",
    "@kiln/sandbox": "workspace:*",
    "ws": "8.23.0",
    "@kiln/lsp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@types/ws": "8.18.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
